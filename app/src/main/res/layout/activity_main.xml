<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:padding="@dimen/screen_padding">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/content_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.43" />

    <LinearLayout
        android:id="@+id/amount_panel"
        android:layout_width="0dp"
        android:layout_height="@dimen/amount_height"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/taka_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/amount_text_size" />

        <TextView
            android:id="@+id/amount_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/section_gap"
            android:minWidth="@dimen/amount_height"
            android:text="@string/zero"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/amount_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notes_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingEnd="@dimen/section_gap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/content_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amount_panel">
            <TextView
                android:id="@+id/note_500"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/screen_padding"
                android:text="500: 0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/note_text_size" />
            <TextView
                android:id="@+id/note_100"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/screen_padding"
                android:text="100: 0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/note_text_size" />
            <TextView
                android:id="@+id/note_50"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/screen_padding"
                android:text="50: 0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/note_text_size" />
            <TextView
                android:id="@+id/note_20"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/screen_padding"
                android:text="20: 0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/note_text_size" />
            <TextView
                android:id="@+id/note_10"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/screen_padding"
                android:text="10: 0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/note_text_size" />
            <TextView
                android:id="@+id/note_5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/screen_padding"
                android:text="5: 0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/note_text_size" />
            <TextView
                android:id="@+id/note_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/screen_padding"
                android:text="2: 0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/note_text_size" />
            <TextView
                android:id="@+id/note_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/screen_padding"
                android:text="1: 0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/note_text_size" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/content_split"
        app:layout_constraintTop_toBottomOf="@id/amount_panel">
            <Button
                android:id="@+id/key_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="1"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="2"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="3"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="4"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="5"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="6"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="7"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="8"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_9"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="9"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="0"
                android:textAllCaps="false"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
            <Button
                android:id="@+id/key_clear"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="@dimen/key_margin"
                android:backgroundTint="@color/key_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="@dimen/key_padding"
                android:text="@string/clear"
                android:textAllCaps="true"
                android:textColor="@color/key_text"
                android:textSize="@dimen/key_text_size" />
    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
